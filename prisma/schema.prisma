generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaperSize {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  active       Boolean       @default(true)
  jobs         Job[]
  pricingRules PricingRule[]
}

model PricingRule {
  id           String    @id @default(cuid())
  paperSizeId  String
  printType    String
  pricePerPage Float     @default(0)
  pricePerCopy Float     @default(0)
  pricePerBook Float     @default(0)
  updatedAt    DateTime  @updatedAt
  paperSize    PaperSize @relation(fields: [paperSizeId], references: [id], onDelete: Cascade)

  @@unique([paperSizeId, printType])
}

model AdditionalService {
  id          String       @id @default(cuid())
  name        String       @unique
  price       Float        @default(0)
  active      Boolean      @default(true)
  jobServices JobService[]
}

model Customer {
  id                 String    @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  notes              String?
  type               String    @default("WALK_IN")
  outstandingBalance Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  invoices           Invoice[]
}

model Job {
  id              String       @id @default(cuid())
  description     String
  paperSizeId     String
  printType       String
  printMode       String
  pages           Int          @default(1)
  copies          Int          @default(1)
  pricingType     String
  baseAmount      Float        @default(0)
  additionalTotal Float        @default(0)
  totalAmount     Float        @default(0)
  notes           String?
  date            DateTime     @default(now())
  invoiceId       String?
  invoice         Invoice?     @relation(fields: [invoiceId], references: [id])
  paperSize       PaperSize    @relation(fields: [paperSizeId], references: [id])
  services        JobService[]
}

model JobService {
  id          String             @id @default(cuid())
  jobId       String
  serviceId   String?
  customLabel String?
  amount      Float
  job         Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service     AdditionalService? @relation(fields: [serviceId], references: [id])
}

model Invoice {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique
  date          DateTime   @default(now())
  dueDate       DateTime?
  customerId    String?
  totalAmount   Float      @default(0)
  paymentStatus String     @default("UNPAID")
  paymentMethod String?
  paymentDate   DateTime?
  notes         String?
  statementId   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  customer      Customer?  @relation(fields: [customerId], references: [id])
  statement     Statement? @relation(fields: [statementId], references: [id])
  jobs          Job[]
}

model Statement {
  id          String    @id @default(cuid())
  statementNo String    @unique
  customerId  String
  month       Int
  year        Int
  totalAmount Float     @default(0)
  paidAmount  Float     @default(0)
  status      String    @default("UNPAID")
  dueDate     DateTime?
  generatedAt DateTime  @default(now())
  invoices    Invoice[]
}
