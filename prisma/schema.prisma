generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF")
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model PaperSize {
  id             String          @id @default(cuid())
  name           String          @unique
  description    String?
  active         Boolean         @default(true)
  jobs           Job[]
  pricingRules   PricingRule[]
  quotationItems QuotationItem[]
}

model PricingRule {
  id           String    @id @default(cuid())
  paperSizeId  String
  printType    String
  pricePerPage Float     @default(0)
  pricePerCopy Float     @default(0)
  pricePerBook Float     @default(0)
  updatedAt    DateTime  @updatedAt
  paperSize    PaperSize @relation(fields: [paperSizeId], references: [id], onDelete: Cascade)

  @@unique([paperSizeId, printType])
}

model AdditionalService {
  id          String       @id @default(cuid())
  name        String       @unique
  price       Float        @default(0)
  active      Boolean      @default(true)
  jobServices JobService[]
}

model Customer {
  id                 String      @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  notes              String?
  type               String      @default("WALK_IN")
  outstandingBalance Float       @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  invoices           Invoice[]
  quotations         Quotation[]
}

model Job {
  id              String       @id @default(cuid())
  description     String
  paperSizeId     String
  printType       String
  printMode       String
  pages           Int          @default(1)
  copies          Int          @default(1)
  pricingType     String
  baseAmount      Float        @default(0)
  additionalTotal Float        @default(0)
  discount        Float        @default(0)
  totalAmount     Float        @default(0)
  notes           String?
  date            DateTime     @default(now())
  invoiceId       String?
  invoice         Invoice?     @relation(fields: [invoiceId], references: [id])
  paperSize       PaperSize    @relation(fields: [paperSizeId], references: [id])
  services        JobService[]
}

model JobService {
  id          String             @id @default(cuid())
  jobId       String
  serviceId   String?
  customLabel String?
  amount      Float
  job         Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service     AdditionalService? @relation(fields: [serviceId], references: [id])
}

model Invoice {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique
  date          DateTime   @default(now())
  dueDate       DateTime?
  customerId    String?
  customerName  String?
  totalAmount   Float      @default(0)
  paymentStatus String     @default("UNPAID")
  paymentMethod String?
  paymentDate   DateTime?
  notes         String?
  statementId   String?
  quotationId   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  customer      Customer?  @relation(fields: [customerId], references: [id])
  statement     Statement? @relation(fields: [statementId], references: [id])
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  jobs          Job[]

  @@index([paymentStatus])
  @@index([date])
  @@index([customerId])
}

model Statement {
  id          String    @id @default(cuid())
  statementNo String    @unique
  customerId  String
  month       Int
  year        Int
  totalAmount Float     @default(0)
  paidAmount  Float     @default(0)
  status      String    @default("UNPAID")
  dueDate     DateTime?
  generatedAt DateTime  @default(now())
  invoices    Invoice[]
}

model Settings {
  id             String  @id @default("default")
  businessName   String  @default("Printax Solutions")
  address        String  @default("132, Kolonnawa Road, Demetagoda, Sri Lanka")
  phone          String  @default("0727245518")
  email          String  @default("mohommadammar826@gmail.com")
  bankName       String  @default("COMMERCIAL BANK")
  accountName    String  @default("MJAAM AMMAR")
  accountNumber  String  @default("8017227052")
  swiftCode      String  @default("")
  branch         String  @default("RAJAGIRIYA")
  logoUrl        String?
  currency               String  @default("LKR")
  defaultQuotationNotes  String? @default("Payment terms: 50% advance upon confirmation. Validity: 14 days.")
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  date            DateTime        @default(now())
  validUntil      DateTime?
  customerId      String?
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  totalAmount     Float           @default(0)
  discount        Float           @default(0)
  status          String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  customer        Customer?       @relation(fields: [customerId], references: [id])
  items           QuotationItem[]
  invoices        Invoice[]

  @@index([status])
  @@index([customerId])
}

model QuotationItem {
  id              String     @id @default(cuid())
  quotationId     String
  description     String
  paperSizeId     String?
  printType       String?    // COLOR, BW
  printMode       String?    // SINGLE, DOUBLE
  pages           Int        @default(1)
  copies          Int        @default(1)
  pricingType     String     @default("MANUAL")
  unitPrice       Float      @default(0)
  baseAmount      Float      @default(0)
  additionalTotal Float      @default(0)
  discount        Float      @default(0)
  totalAmount     Float      @default(0)
  notes           String?
  quotation       Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  paperSize       PaperSize? @relation(fields: [paperSizeId], references: [id])
}

model Expense {
  id            String    @id @default(cuid())
  expenseNumber String    @unique
  title         String
  category      String    // e.g. Raw Materials, Toner/Ink, Maintenance, Utilities, Salaries, Rent, Delivery, Office, Miscellaneous
  amount        Float     @default(0)
  date          DateTime  @default(now())
  paymentMethod String?   @default("CASH") // CASH, BANK_TRANSFER, CARD, CHEQUE
  reference     String?   // Receipt No., Bill No., Check No.
  vendor        String?   // Supplier / Payee
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([date])
  @@index([category])
}
