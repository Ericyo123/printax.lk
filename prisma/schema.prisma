generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF") // ADMIN | STAFF
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaperSize {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  active       Boolean       @default(true)
  pricingRules PricingRule[]
  jobs         Job[]
}

model PricingRule {
  id          String    @id @default(cuid())
  paperSizeId String
  paperSize   PaperSize @relation(fields: [paperSizeId], references: [id], onDelete: Cascade)
  printType   String    // COLOR | BW
  pricePerPage  Float   @default(0)
  pricePerCopy  Float   @default(0)
  pricePerBook  Float   @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([paperSizeId, printType])
}

model AdditionalService {
  id          String            @id @default(cuid())
  name        String            @unique
  price       Float             @default(0)
  active      Boolean           @default(true)
  jobServices JobService[]
}

model Customer {
  id                 String    @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  notes              String?
  type               String    @default("WALK_IN") // WALK_IN | MONTHLY
  outstandingBalance Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  invoices           Invoice[]
}

model Job {
  id              String       @id @default(cuid())
  description     String
  paperSizeId     String
  paperSize       PaperSize    @relation(fields: [paperSizeId], references: [id])
  printType       String       // COLOR | BW
  printMode       String       // SINGLE | DOUBLE
  pages           Int          @default(1)
  copies          Int          @default(1)
  pricingType     String       // PER_PAGE | PER_COPY | PER_BOOK | MANUAL
  baseAmount      Float        @default(0)
  additionalTotal Float        @default(0)
  totalAmount     Float        @default(0)
  notes           String?
  date            DateTime     @default(now())
  invoiceId       String?
  invoice         Invoice?     @relation(fields: [invoiceId], references: [id])
  services        JobService[]
}

model JobService {
  id          String             @id @default(cuid())
  jobId       String
  job         Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     AdditionalService? @relation(fields: [serviceId], references: [id])
  customLabel String?
  amount      Float
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  date          DateTime  @default(now())
  dueDate       DateTime?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  totalAmount   Float     @default(0)
  paymentStatus String    @default("UNPAID") // PAID | UNPAID | PARTIAL
  paymentMethod String?   // CASH | BANK_TRANSFER | CARD | ONLINE | OTHER
  paymentDate   DateTime?
  notes         String?
  statementId   String?
  statement     Statement? @relation(fields: [statementId], references: [id])
  jobs          Job[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Statement {
  id          String    @id @default(cuid())
  statementNo String    @unique
  customerId  String
  month       Int
  year        Int
  totalAmount Float     @default(0)
  paidAmount  Float     @default(0)
  status      String    @default("UNPAID") // PAID | UNPAID | PARTIAL
  dueDate     DateTime?
  generatedAt DateTime  @default(now())
  invoices    Invoice[]
}
